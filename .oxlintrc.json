{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "settings": {
    "react": {
      "version": "16.14.0"
    }
  },
  // node_modules and dist come from .gitignore, which oxlint reads by default
  "ignorePatterns": ["**/migrations"],
  "rules": {
    "no-console": "warn",
    "no-unused-vars": ["error", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }],
    // deliberately off: side-effect imports (polyfills, css, module-alias) are load-bearing,
    // req/e/id are shadowed throughout the server, and the a11y patterns are accepted here
    "no-shadow": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default-member": "off",
    "react/no-unstable-nested-components": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/label-has-associated-control": "off",
    // warn, not error: the remaining violations need real refactors (functional setState,
    // useCallback) rather than dependency additions, which would cause render loops
    "react-hooks/exhaustive-deps": "warn",
    // everything below is picked individually from the pedantic category
    "eqeqeq": "error",
    "no-throw-literal": "error",
    "prefer-promise-reject-errors": "error",
    "preserve-caught-error": "error",
    "no-self-compare": "error",
    "no-return-assign": "error",
    "radix": "error",
    "guard-for-in": "error",
    "no-loop-func": "error",
    "no-constructor-return": "error",
    "no-eval": "error",
    "no-new-wrappers": "error",
    "no-array-constructor": "error",
    "default-case-last": "error",
    "no-lone-blocks": "error",
    "no-object-as-default-parameter": "error",
    "accessor-pairs": "error",
    "no-else-return": "error",
    "react-hooks/rules-of-hooks": "error",
    "no-fallthrough": "error",
    "no-case-declarations": "error",
    "no-redeclare": "error",
    "no-prototype-builtins": "error",
    "no-inner-declarations": "error",
    "import/no-cycle": "error"
  }
}
